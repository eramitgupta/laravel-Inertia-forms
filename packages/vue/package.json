{
    "name": "@erag/inertia-forms-vue",
    "version": "1.0.0",
    "description": "Vue 3 renderer for erag/inertia-forms. Render Laravel-defined forms with one <Form> component.",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "Er Amit Gupta",
        "email": "info.eramitgupta@gmail.com",
        "url": "https://erag.in"
    },
    "bugs": {
        "url": "https://github.com/eramitgupta/laravel-Inertia-forms/issues"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/eramitgupta"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eramitgupta/laravel-Inertia-forms.git",
        "directory": "packages/vue"
    },
    "homepage": "https://erag.in/laravel-inertia-forms/",
    "keywords": [
        "vue",
        "vue3",
        "inertia",
        "inertiajs",
        "laravel",
        "forms",
        "form-builder",
        "tailwind"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "main": "./dist/inertia-forms-vue.js",
    "module": "./dist/inertia-forms-vue.js",
    "types": "./dist/vue/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vue/src/index.d.ts",
            "import": "./dist/inertia-forms-vue.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.7.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "vue": "^3.5.43",
        "vue-tsc": "^3.3.11"
    }
}
